<?xml version="1.0" encoding="utf-8"?>
<!-- Verde – 9 classes → UK bins guide -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guideRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/backButton"
                style="@style/Verde.IconButton"
                android:background="@drawable/bg_back_button"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/guide_title"
                android:textColor="@color/verde_text_main"
                android:textSize="26sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/guide_subtitle"
                android:textColor="@color/verde_text_muted"
                android:textSize="14sp" />

            <!-- Rows are added in code from the WasteClass list -->
            <LinearLayout
                android:id="@+id/binRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/guide_footnote"
                android:textColor="@color/verde_text_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
