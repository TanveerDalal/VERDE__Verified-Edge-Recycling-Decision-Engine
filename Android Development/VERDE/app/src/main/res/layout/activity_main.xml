<?xml version="1.0" encoding="utf-8"?>
<!-- Verde – Home screen (Scan tab) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- ===== Scrollable content ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp">

            <!-- Header: logo + status pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_logo">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_leaf"
                        app:tint="@color/verde_dark" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/verde_text_main"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pillText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="@string/status_pi_connected"
                    android:textColor="@color/verde_green_soft"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/bg_dot_green" />
            </LinearLayout>

            <!-- Greeting -->
            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/greeting_evening"
                android:textColor="@color/verde_text_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/home_title"
                android:textColor="@color/verde_text_main"
                android:textSize="26sp" />

            <!-- Pi camera | Phone camera switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_toggle_track"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/togglePi"
                    style="@style/Verde.Toggle"
                    android:layout_marginEnd="2dp"
                    android:text="@string/source_pi"
                    app:drawableStartCompat="@drawable/ic_chip" />

                <TextView
                    android:id="@+id/togglePhone"
                    style="@style/Verde.Toggle"
                    android:layout_marginStart="2dp"
                    android:text="@string/source_phone"
                    app:drawableStartCompat="@drawable/ic_phone" />
            </LinearLayout>

            <!-- Camera feed box -->
            <FrameLayout
                android:id="@+id/feedBox"
                android:layout_width="match_parent"
                android:layout_height="262dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_feed">

                <!-- Live phone-camera preview (hidden until Phone camera is chosen) -->
                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:implementationMode="compatible"
                    app:scaleType="fillCenter" />

                <!-- Live stream from the Raspberry Pi (shown when Pi camera is chosen) -->
                <WebView
                    android:id="@+id/piFeed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="18dp"
                    android:background="@drawable/bg_live_chip"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/live"
                    android:textColor="@color/verde_text_main"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/bg_dot_red" />

                <!-- Switch back ⇄ front camera (only shown for the phone camera) -->
                <ImageButton
                    android:id="@+id/flipButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="@string/cd_flip_camera"
                    android:src="@drawable/ic_flip_camera"
                    android:visibility="gone"
                    app:tint="@color/verde_text_main" />

                <ImageView
                    android:layout_width="210dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/frame_corners" />

                <LinearLayout
                    android:id="@+id/feedPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/verde_green" />

                    <TextView
                        android:id="@+id/feedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/feed_pi"
                        android:textColor="@color/verde_green_text"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/feed_hint"
                        android:textColor="@color/verde_text_faint"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Scan item button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanButton"
                style="@style/Verde.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/scan_item"
                android:textSize="17sp"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_scan" />

            <!-- Last scan card -->
            <LinearLayout
                android:id="@+id/lastScanCard"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:baselineAligned="false"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/lastScanTile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tile"
                    android:gravity="center"
                                        android:textColor="@color/verde_tile_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lastScanTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/verde_text_faint"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/lastScanResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/verde_text_main"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/cd_open_last_scan"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/verde_text_faint" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== Bottom navigation (shared, see bottom_nav.xml) ===== -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav" />
</FrameLayout>
