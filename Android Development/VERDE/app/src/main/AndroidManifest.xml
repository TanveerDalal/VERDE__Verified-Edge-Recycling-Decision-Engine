<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera: ask permission; the app can still install on devices without a camera -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Talk to the Raspberry Pi over Wi-Fi -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keep Verde's Llama answering WhatsApp in the background (LlamaService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- usesCleartextTraffic: the Pi uses plain http:// -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VERDE"
        android:usesCleartextTraffic="true">

        <!-- 1. Splash (opens when the app starts) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Home (Scan tab) -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <!-- 3. Result -->
        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false" />

        <!-- 4. Chat (Ask tab): message box moves above the keyboard -->
        <activity
            android:name=".ui.ask.AskActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Impact tab (what your scans add up to) -->
        <activity
            android:name=".ui.impact.ImpactActivity"
            android:exported="false" />

        <!-- History tab (every saved scan) -->
        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false" />

        <!-- 5. Bin guide -->
        <activity
            android:name=".ui.guide.BinGuideActivity"
            android:exported="false" />

        <!-- 6. Friend's original screens (Compose, unchanged): long-press "Verde" on Home -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/benchmark_title" />

        <!-- 7. Keeps Llama + the port-5001 server running for WhatsApp ("Verde Llama is running") -->
        <service
            android:name=".core.LlamaService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device Llama server that answers the user's WhatsApp recycling questions" />
        </service>
    </application>

</manifest>
