<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera: ask permission; the app can still install on devices without a camera -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Talk to the Raspberry Pi over Wi-Fi -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: the Pi uses plain http:// -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VERDE"
        android:usesCleartextTraffic="true">

        <!-- 1. Splash (opens when the app starts) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Home (Scan tab) -->
        <activity
            android:name=".ui.home.MainActivity"
            android:exported="false" />

        <!-- 3. Result -->
        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false" />

        <!-- 4. Chat (Ask tab): message box moves above the keyboard -->
        <activity
            android:name=".ui.ask.AskActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Bin guide -->
        <activity
            android:name=".ui.guide.BinGuideActivity"
            android:exported="false" />
    </application>

</manifest>